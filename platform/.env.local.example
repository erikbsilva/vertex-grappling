# Supabase project (shared with the landing page project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email of the coach account (used to grant access to /admin)
ADMIN_EMAIL=coach@example.com

# Base URL of this app, used to build auth redirect/callback links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: enables automatic translation of coach feedback into the
# student's chosen language (Módulo 3). Without it, students see the
# original (Portuguese) feedback text.
OPENAI_API_KEY=
